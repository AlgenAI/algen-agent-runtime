{
  "uid": "algen-runtime-models-tools",
  "title": "Algen Agent Runtime: models, tools and policies",
  "description": "Model provider calls, latency, errors and tokens; tool calls, latency, failures and guard refusals; policy denials and errors.",
  "tags": [
    "algen",
    "algen-agent-runtime"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "",
  "links": [
    {
      "title": "Operations guide",
      "type": "link",
      "url": "https://github.com/AlgenAI/algen-agent-runtime/blob/main/docs/operations.md#metrics-dashboards-and-alerts",
      "targetBlank": true,
      "icon": "doc",
      "tags": [],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tooltip": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "name": "job",
        "label": "Runtime",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(algen_agent_runtime_runs_started_total, job)",
          "refId": "job"
        },
        "definition": "label_values(algen_agent_runtime_runs_started_total, job)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Models",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Model calls by provider and model",
      "description": "",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (provider, model) (rate(algen_agent_runtime_model_calls_total{job=~\"$job\"}[5m]))",
          "legendFormat": "{{provider}}/{{model}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Model errors by kind",
      "description": "",
      "id": 3,
