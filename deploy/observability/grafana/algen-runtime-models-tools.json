          "expr": "sum by (provider, model) (rate(algen_agent_runtime_model_calls_total{job=~\"$job\", outcome=\"error\"}[5m])) / sum by (provider, model) (rate(algen_agent_runtime_model_calls_total{job=~\"$job\"}[5m]))",
          "legendFormat": "{{provider}}/{{model}}",
          "refId": "A",
          "range": true
