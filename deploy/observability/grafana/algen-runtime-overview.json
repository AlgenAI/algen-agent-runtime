        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(algen_agent_runtime_runs_finished_total{job=~\"$job\", status=\"completed\"}[1h])) / sum(increase(algen_agent_runtime_runs_finished_total{job=~\"$job\"}[1h]))",
          "legendFormat": "completed",
          "refId": "A",
          "range": true
        }
